NODE_ENV=development
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_NAME=cho_do_cu
DB_USER=cho_do_cu
DB_PASSWORD=cho_do_cu_password
DB_ROOT_PASSWORD=root_password_change_me
DB_LOGGING=false

# Tùy chọn khi development; production bắt buộc có khóa bí mật dài và ngẫu nhiên.
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=

# Tùy chọn khi development (OTP hiện trong log API); production cần SMTP để gửi email.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# Chỉ đặt email khi muốn thử gửi OTP thật lúc development; mặc định dùng log.
OTP_DELIVERY_MODE=development-log

# Cấu hình D01 - đặt hàng và giữ món.
ORDER_RESERVATION_MINUTES=15
ORDER_RESERVATION_SCAN_MS=30000
ORDER_RESERVATION_BATCH_SIZE=50
ORDER_COMMISSION_RATE=0

# Chỉ bật trên môi trường test nhóm; D01 preview/create và D02 preview/cancel dùng tài khoản cố định.
# Không thay thế đăng nhập thật, không mở /me/admin/refund hoặc API khác.
D01_DEMO_MODE=false
# ID tài khoản ACTIVE, không có ADMIN; phải kiểm tra DB trước khi bật.
D01_DEMO_USER_ID=

# Seeder luôn dùng ít nhất 100001 để đáp ứng yêu cầu môn học.
SEED_RECORDS_PER_TABLE=100001
SEED_BATCH_SIZE=5000

# B05 - AI sàng lọc tin đăng (Claude). Để trống thì tính năng AI tắt, web vẫn chạy.
ANTHROPIC_API_KEY=
