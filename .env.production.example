# Copy this file to .env on the VPS and replace every placeholder.
# For VPS deployment only, also set APP_DOMAIN to the real domain you own.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

DB_NAME=cho_do_cu
DB_USER=cho_do_cu
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# SMTP credentials for sending registration verification codes.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-support-gmail@gmail.com
MAIL_PASS=your-google-app-password
