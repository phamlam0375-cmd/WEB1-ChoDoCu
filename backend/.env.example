NODE_ENV=development
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_NAME=cho_do_cu
DB_USER=cho_do_cu
DB_PASSWORD=cho_do_cu_password
DB_ROOT_PASSWORD=root_password_change_me
DB_LOGGING=false

# Khóa ký JWT HS256. Phải thay bằng chuỗi bí mật dài và ngẫu nhiên khi triển khai.
JWT_SECRET=replace_with_a_long_random_secret

# Cấu hình D01 - đặt hàng và giữ món.
ORDER_RESERVATION_MINUTES=15
ORDER_RESERVATION_SCAN_MS=30000
ORDER_RESERVATION_BATCH_SIZE=50
ORDER_COMMISSION_RATE=0

# Seeder luôn dùng ít nhất 100001 để đáp ứng yêu cầu môn học.
SEED_RECORDS_PER_TABLE=100001
SEED_BATCH_SIZE=5000
