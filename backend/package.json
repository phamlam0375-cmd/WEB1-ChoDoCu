{
  "name": "cho-do-cu-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend đồ án website Chợ Đồ Cũ - nhóm 4 sinh viên",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --legacy-watch --polling-interval 500 src/server.js",
    "start": "node src/server.js",
    "db:prepare": "node scripts/prepare-db.js",
    "docker:dev": "node scripts/prepare-db.js && nodemon --legacy-watch --polling-interval 500 src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:verify": "node scripts/verify-seed-counts.js",
    "db:reset": "npm run db:seed:undo && npm run db:migrate:undo && npm run db:migrate && npm run db:seed && npm run db:verify",
    "admin:grant": "node scripts/grant-admin-role.js",
    "check": "node scripts/static-check.js",
    "test": "node --test tests/*.test.js",
    "test:concurrency": "node scripts/verify-order-concurrency.js",
    "auth:token": "node scripts/create-dev-token.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jest": "^30.5.2",
    "jpeg-js": "0.4.4",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.16",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.2",
    "socket.io": "^4.8.4",
    "supertest": "^7.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "packageManager": "pnpm@10.34.5"
}
